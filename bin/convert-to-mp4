#!/usr/bin/env bash

DRY_RUN=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true; shift ;;
    -*) echo "Unknown option: $1" >&2; exit 1 ;;
    *) DIR="$1"; shift ;;
  esac
done

DIR="${DIR:-.}"

if [[ ! -d "$DIR" ]]; then
  echo "Error: not a directory: $DIR" >&2
  exit 1
fi

COUNT_ALREADY_DONE=0
COUNT_MOVED_FROM_CONVERTED=0
COUNT_REMUXED=0
COUNT_CONVERTED=0
COUNT_REPAIRED=0
COUNT_MP4_OK=0
COUNT_RELABELED=0
COUNT_SKIPPED=0
COUNT_ERRORS=0

# Video codecs .mp4 files can carry that iMovie can't import, despite the
# container itself being perfectly valid (e.g. AI-generated clips encoded as
# AV1). ffprobe won't flag these as broken since nothing is actually wrong
# with the file -- the codec is just unsupported downstream.
is_bad_mp4_codec() {
  case "$1" in
    av1|vp9|vp8|mpeg2video) return 0 ;;
    *) return 1 ;;
  esac
}

do_mkdir() {
  if [[ "$DRY_RUN" == true ]]; then
    echo "  [dry-run] mkdir -p '$1'"
  else
    mkdir -p "$1"
  fi
}

do_move() {
  if [[ "$DRY_RUN" == true ]]; then
    echo "  [dry-run] mv '$1' '$2'"
  else
    mv "$1" "$2"
  fi
}

while IFS= read -r -d $'\0' FILE; do
  [[ -f "$FILE" ]] || continue

  PARENT="$(dirname "$FILE")"
  FILENAME="$(basename "$FILE")"
  BASE="${FILENAME%.*}"
  MP4="$PARENT/$BASE.mp4"
  MP4_TMP="$PARENT/$BASE.tmp.mp4"
  M4V="$PARENT/$BASE.m4v"
  CONVERTED_MP4="$PARENT/converted/$BASE.mp4"
  ORIG_FILE="$PARENT/orig/$FILENAME"

  case "${FILENAME##*.}" in
    [Mm]4[Vv]) IS_M4V=true; IS_MP4=false; IS_WEBM=false ;;
    [Mm][Pp]4) IS_M4V=false; IS_MP4=true; IS_WEBM=false ;;
    [Ww][Ee][Bb][Mm]) IS_M4V=false; IS_MP4=false; IS_WEBM=true ;;
    *) IS_M4V=false; IS_MP4=false; IS_WEBM=false ;;
  esac

  if [[ -f "$ORIG_FILE" ]]; then
    echo "SKIP (already processed, found in orig/): $FILE"
    COUNT_SKIPPED=$(( COUNT_SKIPPED + 1 ))
    continue
  fi

  if [[ "$IS_MP4" == true ]]; then
    # $FILE already has a .mp4 extension, so $MP4 is the same path as $FILE --
    # the generic "$MP4 exists alongside" check below doesn't apply. Instead,
    # check whether the video codec is one that's mislabeled-valid but that
    # iMovie can't actually open, and if so repair it in place. The broken
    # original is archived to orig/, same as every other format this script
    # handles -- the top-of-loop $ORIG_FILE check above already makes this
    # idempotent on rerun.
    VCODEC="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$FILE" 2>/dev/null)"

    if [[ -z "$VCODEC" ]]; then
      echo "  WARNING: could not probe video codec, skipping: $FILE"
      COUNT_ERRORS=$(( COUNT_ERRORS + 1 ))
      continue
    fi

    if ! is_bad_mp4_codec "$VCODEC"; then
      COUNT_MP4_OK=$(( COUNT_MP4_OK + 1 ))
      continue
    fi

    echo "REPAIRING (incompatible codec: $VCODEC): $FILE"
    if [[ "$DRY_RUN" == true ]]; then
      echo "  [dry-run] ffmpeg -i '$FILE' -c:v libx264 -crf 18 -preset fast -c:a aac '$MP4_TMP'"
      do_mkdir "$PARENT/orig"
      do_move "$FILE" "$ORIG_FILE"
      echo "  [dry-run] mv '$MP4_TMP' '$MP4'"
      COUNT_REPAIRED=$(( COUNT_REPAIRED + 1 ))
    else
      if ffmpeg -nostdin -y -loglevel error -i "$FILE" \
          -c:v libx264 -crf 18 -preset fast -c:a aac "$MP4_TMP"; then
        do_mkdir "$PARENT/orig"
        do_move "$FILE" "$ORIG_FILE"
        mv "$MP4_TMP" "$MP4"
        COUNT_REPAIRED=$(( COUNT_REPAIRED + 1 ))
      else
        rm -f "$MP4_TMP"
        echo "  ERROR: repair failed for $FILE"
        COUNT_ERRORS=$(( COUNT_ERRORS + 1 ))
      fi
    fi
    continue
  fi

  if [[ -f "$MP4" ]]; then
    echo "FOUND (mp4 exists alongside): $FILE"
    do_mkdir "$PARENT/orig"
    do_move "$FILE" "$ORIG_FILE"
    COUNT_ALREADY_DONE=$(( COUNT_ALREADY_DONE + 1 ))

  elif [[ "$IS_M4V" == true ]]; then
    echo "REMUXING (m4v → mp4): $FILE"
    if [[ "$DRY_RUN" == true ]]; then
      echo "  [dry-run] ffmpeg -nostdin -y -loglevel error -i '$FILE' -c copy '$MP4'"
      do_mkdir "$PARENT/orig"
      do_move "$FILE" "$ORIG_FILE"
      COUNT_REMUXED=$(( COUNT_REMUXED + 1 ))
    else
      if ffmpeg -nostdin -y -loglevel error -i "$FILE" -c copy "$MP4_TMP"; then
        mv "$MP4_TMP" "$MP4"
        do_mkdir "$PARENT/orig"
        do_move "$FILE" "$ORIG_FILE"
        COUNT_REMUXED=$(( COUNT_REMUXED + 1 ))
      else
        rm -f "$MP4_TMP"
        echo "  ERROR: remux failed for $FILE"
        COUNT_ERRORS=$(( COUNT_ERRORS + 1 ))
      fi
    fi

  elif [[ -f "$M4V" ]]; then
    echo "REMUXING (m4v sibling → mp4): $FILE"
    ORIG_M4V="$PARENT/orig/$(basename "$M4V")"
    if [[ "$DRY_RUN" == true ]]; then
      echo "  [dry-run] ffmpeg -nostdin -y -loglevel error -i '$M4V' -c copy '$MP4'"
      do_mkdir "$PARENT/orig"
      do_move "$M4V" "$ORIG_M4V"
      do_move "$FILE" "$ORIG_FILE"
      COUNT_REMUXED=$(( COUNT_REMUXED + 1 ))
    else
      if ffmpeg -nostdin -y -loglevel error -i "$M4V" -c copy "$MP4_TMP"; then
        mv "$MP4_TMP" "$MP4"
        do_mkdir "$PARENT/orig"
        do_move "$M4V" "$ORIG_M4V"
        do_move "$FILE" "$ORIG_FILE"
        COUNT_REMUXED=$(( COUNT_REMUXED + 1 ))
      else
        rm -f "$MP4_TMP"
        echo "  ERROR: remux failed for $M4V"
        COUNT_ERRORS=$(( COUNT_ERRORS + 1 ))
      fi
    fi

  elif [[ -f "$CONVERTED_MP4" ]]; then
    echo "FOUND (mp4 in converted/ subdir): $FILE"
    do_mkdir "$PARENT/orig"
    do_move "$CONVERTED_MP4" "$MP4"
    do_move "$FILE" "$ORIG_FILE"
    COUNT_MOVED_FROM_CONVERTED=$(( COUNT_MOVED_FROM_CONVERTED + 1 ))

  elif [[ "$IS_WEBM" == true ]] \
      && WEBM_MIME="$(file --mime-type -b "$FILE" 2>/dev/null)" \
      && [[ "$WEBM_MIME" == "video/mp4" || "$WEBM_MIME" == "audio/mp4" ]]; then
    # Some .webm-named files are actually mp4 content (mislabeled at
    # download/export time). Re-encoding one of these would be pure waste --
    # remux it instead, same fast path as the m4v case above.
    echo "REMUXING (mislabeled: .webm is actually $WEBM_MIME): $FILE"
    if [[ "$DRY_RUN" == true ]]; then
      echo "  [dry-run] ffmpeg -nostdin -y -loglevel error -i '$FILE' -c copy '$MP4'"
      do_mkdir "$PARENT/orig"
      do_move "$FILE" "$ORIG_FILE"
      COUNT_RELABELED=$(( COUNT_RELABELED + 1 ))
    else
      if ffmpeg -nostdin -y -loglevel error -i "$FILE" -c copy "$MP4_TMP"; then
        mv "$MP4_TMP" "$MP4"
        do_mkdir "$PARENT/orig"
        do_move "$FILE" "$ORIG_FILE"
        COUNT_RELABELED=$(( COUNT_RELABELED + 1 ))
      else
        rm -f "$MP4_TMP"
        echo "  ERROR: remux failed for $FILE"
        COUNT_ERRORS=$(( COUNT_ERRORS + 1 ))
      fi
    fi

  else
    echo "CONVERTING: $FILE"
    if [[ "$DRY_RUN" == true ]]; then
      echo "  [dry-run] ffmpeg -i '$FILE' ... '$MP4'"
      do_mkdir "$PARENT/orig"
      do_move "$FILE" "$ORIG_FILE"
      COUNT_CONVERTED=$(( COUNT_CONVERTED + 1 ))
    else
      if ffmpeg -nostdin -y -loglevel error -i "$FILE" \
          -c:v libx264 -crf 18 -preset fast -c:a aac "$MP4_TMP"; then
        mv "$MP4_TMP" "$MP4"
        do_mkdir "$PARENT/orig"
        do_move "$FILE" "$ORIG_FILE"
        COUNT_CONVERTED=$(( COUNT_CONVERTED + 1 ))
      else
        rm -f "$MP4_TMP"
        echo "  ERROR: conversion failed for $FILE"
        COUNT_ERRORS=$(( COUNT_ERRORS + 1 ))
      fi
    fi
  fi

done < <(find "$DIR" -type f \
  -not -path "*/orig/*" \
  -not -path "*/converted/*" \
  \( -iname "*.mpg" -o -iname "*.mpeg" -o -iname "*.avi" -o -iname "*.mov" \
     -o -iname "*.mkv" -o -iname "*.wmv" -o -iname "*.flv" -o -iname "*.m4v" \
     -o -iname "*.3gp" -o -iname "*.mts"  -o -iname "*.m2ts" -o -iname "*.ts" \
     -o -iname "*.webm" -o -iname "*.ogv"  -o -iname "*.vob" \
     -o -iname "*.rm"  -o -iname "*.asf"  -o -iname "*.divx" -o -iname "*.qt" \
     -o -iname "*.mp4" \) \
  -print0 | sort -z)

TOTAL=$(( COUNT_ALREADY_DONE + COUNT_MOVED_FROM_CONVERTED + COUNT_REMUXED + COUNT_CONVERTED + COUNT_REPAIRED + COUNT_MP4_OK + COUNT_RELABELED + COUNT_SKIPPED + COUNT_ERRORS ))

echo ""
DRY_RUN_LABEL=""
[[ "$DRY_RUN" == true ]] && DRY_RUN_LABEL="dry run, "
echo "Summary (${DRY_RUN_LABEL}$TOTAL files):"
printf "  %-37s %4d\n" "Already converted (mp4 alongside):" "$COUNT_ALREADY_DONE"
printf "  %-37s %4d\n" "Moved from converted/ subdir:" "$COUNT_MOVED_FROM_CONVERTED"
printf "  %-37s %4d\n" "Remuxed (m4v -> mp4):" "$COUNT_REMUXED"
printf "  %-37s %4d\n" "Newly converted:" "$COUNT_CONVERTED"
printf "  %-37s %4d\n" "Repaired (bad codec in .mp4):" "$COUNT_REPAIRED"
printf "  %-37s %4d\n" "Already fine .mp4 (left alone):" "$COUNT_MP4_OK"
printf "  %-37s %4d\n" "Relabeled (.webm was really mp4):" "$COUNT_RELABELED"
printf "  %-37s %4d\n" "Skipped (already in orig/):" "$COUNT_SKIPPED"
if [[ $COUNT_ERRORS -gt 0 ]]; then
  printf "  %-37s %4d\n" "Errors:" "$COUNT_ERRORS"
fi
