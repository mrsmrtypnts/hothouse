#!/usr/bin/env bash

usage() {
  echo "Usage: $0 [--top N] [directory]" >&2
}

TOP=10

while [[ $# -gt 0 ]]; do
  case "$1" in
    --top) TOP="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "Unknown option: $1" >&2; usage; exit 1 ;;
    *) DIR="$1"; shift ;;
  esac
done

DIR="${DIR:-.}"

if [[ ! -d "$DIR" ]]; then
  echo "Error: not a directory: $DIR" >&2
  exit 1
fi

declare -A PENDING
declare -A DONE

# Video codecs .mp4 files can carry that iMovie can't import (keep in sync
# with convert-to-mp4's is_bad_mp4_codec).
is_bad_mp4_codec() {
  case "$1" in
    av1|vp9|vp8|mpeg2video) return 0 ;;
    *) return 1 ;;
  esac
}
export -f is_bad_mp4_codec

# Count pending files per directory (keep extension list in sync with convert-to-mp4).
# Non-mp4 formats: "pending" means no sibling .mp4 exists yet -- cheap, sequential.
while IFS= read -r -d $'\0' FILE; do
  PARENT="$(dirname "$FILE")"
  if [[ ! -f "${FILE%.*}.mp4" ]]; then
    PENDING["$PARENT"]=$(( ${PENDING["$PARENT"]:-0} + 1 ))
  fi
done < <(find "$DIR" -type f \
  -not -path "*/orig/*" \
  -not -path "*/converted/*" \
  \( -iname "*.mpg"  -o -iname "*.mpeg" -o -iname "*.avi"  -o -iname "*.mov" \
     -o -iname "*.mkv"  -o -iname "*.wmv"  -o -iname "*.flv"  -o -iname "*.m4v" \
     -o -iname "*.3gp"  -o -iname "*.mts"  -o -iname "*.m2ts" -o -iname "*.ts" \
     -o -iname "*.webm" -o -iname "*.ogv"  -o -iname "*.vob" \
     -o -iname "*.rm"   -o -iname "*.asf"  -o -iname "*.divx" -o -iname "*.qt" \) \
  -print0)

# .mp4 files: "pending" means the video codec needs repairing (no sibling
# check makes sense -- $FILE is its own sibling). ffprobe-per-file is the
# bottleneck here, so run the checks across cores instead of one at a time.
JOBS="$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)"
while IFS= read -r PARENT; do
  [[ -n "$PARENT" ]] || continue
  PENDING["$PARENT"]=$(( ${PENDING["$PARENT"]:-0} + 1 ))
done < <(find "$DIR" -type f \
  -not -path "*/orig/*" \
  -not -path "*/converted/*" \
  -iname "*.mp4" -print0 | \
  xargs -0 -P "$JOBS" -n1 bash -c '
    codec="$(ffprobe -v error -select_streams v:0 -show_entries stream=codec_name -of csv=p=0 "$1" 2>/dev/null)"
    is_bad_mp4_codec "$codec" && dirname -- "$1"
    true
  ' _)

# Count done files per directory (source files moved to orig/ by convert-to-mp4)
while IFS= read -r -d $'\0' FILE; do
  PARENT="$(dirname "$(dirname "$FILE")")"   # parent of the orig/ dir
  DONE["$PARENT"]=$(( ${DONE["$PARENT"]:-0} + 1 ))
done < <(find "$DIR" -type f \
  -path "*/orig/*" \
  \( -iname "*.mpg"  -o -iname "*.mpeg" -o -iname "*.avi"  -o -iname "*.mov" \
     -o -iname "*.mkv"  -o -iname "*.wmv"  -o -iname "*.flv"  -o -iname "*.m4v" \
     -o -iname "*.3gp"  -o -iname "*.mts"  -o -iname "*.m2ts" -o -iname "*.ts" \
     -o -iname "*.webm" -o -iname "*.ogv"  -o -iname "*.vob" \
     -o -iname "*.rm"   -o -iname "*.asf"  -o -iname "*.divx" -o -iname "*.qt" \
     -o -iname "*.mp4" \) \
  -print0)

if [[ ${#PENDING[@]} -eq 0 ]]; then
  echo "No pending conversions found under $DIR"
  exit 0
fi

printf "\n  %7s  %6s  %s\n" "Pending" "Done" "Directory"
printf "  %7s  %6s  %s\n" "-------" "----" "---------"

for dir in "${!PENDING[@]}"; do
  printf "%d\t%d\t%s\n" "${PENDING[$dir]}" "${DONE[$dir]:-0}" "$dir"
done | sort -t$'\t' -k1 -rn | head -n "$TOP" | \
while IFS=$'\t' read -r pending ndone dir; do
  printf "  %7d  %6d  %s\n" "$pending" "$ndone" "$dir"
done
